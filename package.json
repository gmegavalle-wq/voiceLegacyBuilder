{
  "name": "voice-legacy-builder",
  "version": "1.0.0",
  "description": "Entrenar, guardar y sintetizar voces privadas localmente en tu dispositivo. Sin servidores, sin APIs externas.",
  "author": {
    "name": "Voice Legacy Team"
  },
  "license": "MIT",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "eas build --platform android --auto-submit",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "serve:web": "node scripts/serve-web.js",
    "build": "expo prebuild --clean",
    "build:web": "expo export --platform web",
    "build:android": "expo prebuild --platform android",
    "build:ios": "expo prebuild --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.{js,jsx}",
    "type-check": "flow check",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "clean": "rm -rf node_modules .expo dist build coverage",
    "doctor": "expo doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10",
    "react-native-encrypted-storage": "^4.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "^18.2.0",
    "babel-preset-expo": "^10.0.1",
    "eslint": "^8.56.0",
    "eslint-config-expo": "^7.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^50.0.1",
    "prettier": "^3.2.0",
    "react-test-renderer": "18.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
